<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="840.0" prefWidth="1250.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="form.MainController">
   <children>
      <MenuBar maxHeight="-Infinity" minHeight="-Infinity">
         <menus>
            <Menu mnemonicParsing="false" text="File">
               <items>
                  <MenuItem fx:id="importFile" mnemonicParsing="false" onAction="#importFile" text="Import" />
                  <MenuItem fx:id="importFileAndConcatenate" mnemonicParsing="false" onAction="#importFileAndConcatenate" text="Import and concatenate" />
                  <MenuItem fx:id="exportFile" mnemonicParsing="false" onAction="#exportFile" text="Export" />
                  <MenuItem fx:id="extendedSteps" mnemonicParsing="false" onAction="#extendedSteps" text="Extended steps" />
                  <MenuItem fx:id="clearSteps" mnemonicParsing="false" onAction="#clearSteps" text="Clear all" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
      <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
         <children>
            <Pane fx:id="mainViewPane" maxWidth="1.7976931348623157E308" minHeight="-Infinity" prefHeight="200.0" prefWidth="1000.0">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Pane>
            <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
               <children>
                  <TitledPane collapsible="false" maxWidth="1.7976931348623157E308" prefWidth="250.0" text="View Mode">
                     <content>
                        <VBox maxWidth="1.7976931348623157E308">
                           <children>
                              <CheckBox fx:id="outlineVisible" mnemonicParsing="false" onAction="#outlineVisibleChanged" selected="true" text="Outline">
                                 <padding>
                                    <Insets bottom="5.0" />
                                 </padding>
                              </CheckBox>
										<RadioButton fx:id="AllView" mnemonicParsing="false" onAction="#changeToAllView" text="All (Hide not lighted)">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="viewModes" />
                                 </toggleGroup>
                                 <padding>
                                    <Insets bottom="2.0" />
                                 </padding>
                              </RadioButton>
                              <RadioButton fx:id="XY_View" mnemonicParsing="false" onAction="#changeToXY" selected="true" text="XY" toggleGroup="$viewModes">
                                 <padding>
                                    <Insets bottom="2.0" />
                                 </padding></RadioButton>
                              <RadioButton fx:id="XZ_View" mnemonicParsing="false" onAction="#changeToXZ" text="XZ" toggleGroup="$viewModes">
                                 <padding>
                                    <Insets bottom="2.0" />
                                 </padding></RadioButton>
                              <RadioButton fx:id="YZ_View" mnemonicParsing="false" onAction="#changeToYZ" text="YZ" toggleGroup="$viewModes" />
                              <Label fx:id="currentLayer" text="Current Layer：">
                                 <VBox.margin>
                                    <Insets bottom="5.0" top="10.0" />
                                 </VBox.margin>
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
                                 <children>
                                    <Button fx:id="previousLayer" minWidth="-Infinity" mnemonicParsing="false" onAction="#previousLayer" prefWidth="95.0" text="Previous layer" />
                                    <Button fx:id="nextLayer" minWidth="-Infinity" mnemonicParsing="false" onAction="#nextLayer" prefWidth="95.0" text="Next layer">
                                       <HBox.margin>
                                          <Insets left="10.0" />
                                       </HBox.margin>
                                    </Button>
                                 </children>
                                 <VBox.margin>
                                    <Insets top="5.0" />
                                 </VBox.margin>
                              </HBox>
                           </children>
                        </VBox>
                     </content>
                  </TitledPane>
                  <TitledPane collapsible="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefHeight="800.0" text="Steps">
                     <content>
                        <ScrollPane fx:id="stepPanes" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" vbarPolicy="ALWAYS">
                           <content>
                              <VBox fx:id="stepPanesContainer" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" />
                           </content></ScrollPane>
                     </content>
                     <VBox.margin>
                        <Insets bottom="5.0" top="5.0" />
                     </VBox.margin>
                  </TitledPane>
                  <TitledPane collapsible="false" maxWidth="1.7976931348623157E308" minWidth="-Infinity" text="Play">
                     <content>
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <Button fx:id="playAnimation" mnemonicParsing="false" onAction="#playAnimation" prefWidth="30.0" text="▶">
                                 <HBox.margin>
                                    <Insets right="5.0" />
                                 </HBox.margin>
                              </Button>
                              <Button fx:id="pauseAnimation" disable="true" mnemonicParsing="false" onAction="#pauseAnimation" prefWidth="30.0" text="⏸">
                                 <HBox.margin>
                                    <Insets left="5.0" right="5.0" />
                                 </HBox.margin>
                              </Button>
                              <Button fx:id="stopAnimation" disable="true" mnemonicParsing="false" onAction="#stopAnimation" prefWidth="30.0" text="⏹">
                                 <HBox.margin>
                                    <Insets left="5.0" />
                                 </HBox.margin>
                              </Button>
                           </children>
                        </HBox>
                     </content>
                  </TitledPane>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
